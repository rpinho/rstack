#!/usr/bin/env python3
"""PreToolUse: judgment instructions name leaderboard roles instead of models."""
from pathlib import Path
import os
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'hooks'))
import _hookfail

REASON = ('name the leaderboard role, not a model (LEADERBOARD.md). '
          'Budget limits are job counts or caps, never a model swap. '
          'use launch.sh --role review --made-by MODEL.')


def triage(raw, event):
    return any(word in raw for word in ('SendMessage', 'tell-general', 'lane-briefs',
                                       'Agent', 'claude', 'codex'))


def body(event):
    # Import inside the guarded body so a missing installation is a visible refusal.
    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'harness'))
    sys.path.append(str(Path(os.environ.get('RH_ROOT') or '~/.local/share/research-harness').expanduser()))
    from worker_models import (assigns_judgment_model, judgment_task, shell_commands,
                               command_argv, judgment_command)

    tool = event.get('tool_name')
    if tool not in ('SendMessage', 'Bash', 'Write', 'Edit', 'Agent'):
        return 0
    payload = event.get('tool_input')
    if not isinstance(payload, dict):
        raise ValueError('tool_input must be an object')
    texts = []
    if tool == 'Agent':
        model = payload.get('model', '')
        instructions = [payload.get(key, '') for key in ('description', 'prompt')]
        if not isinstance(model, str) or any(not isinstance(t, str) for t in instructions):
            raise ValueError('Agent model and instructions must be text')
        if model and any(judgment_task(t) or assigns_judgment_model(t) for t in instructions):
            print(REASON, file=sys.stderr)
            return 2
    elif tool == 'SendMessage':
        texts = [payload['message']]
    elif tool == 'Bash':
        command = payload['command']
        for args, piped in shell_commands(command):
            argv = command_argv(args)
            if argv and Path(argv[0]).name == 'tell-general':
                texts.extend(argv[1:])
                texts.append(' '.join(argv[2:]).lstrip('\"\x27'))
            if judgment_command(args, piped):
                print(REASON, file=sys.stderr)
                return 2
    else:
        path = payload['file_path']
        if not isinstance(path, str):
            raise ValueError('file_path must be text')
        if 'lane-briefs' in Path(path).parts:
            texts = [payload['content' if tool == 'Write' else 'new_string']]
    for text in texts:
        if not isinstance(text, str):
            raise ValueError('outgoing text must be text')
        if assigns_judgment_model(text):
            print(REASON, file=sys.stderr)
            return 2
    return 0


if __name__ == '__main__':
    sys.exit(_hookfail.run('model-instruction-gate', body, triage,
                          guards='judgment instructions in messages, Agent, Bash and lane-briefs'))
