#!/usr/bin/env python3
"""PreToolUse: judgment instructions name leaderboard roles instead of models."""
from pathlib import Path
import re
import shlex
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'hooks'))
import _hookfail

MODEL = re.compile(r'\b(?:sonnet|haiku|opus|fable|astra|sol|deepseek|kimi|glm)\b|\b(?:gpt-|claude-)', re.I)
CHEAP_MODEL = re.compile(r'\b(?:sonnet|haiku)\b', re.I)
JUDGMENT = re.compile(r'\b(?:referees?|reviews?|judges?|audits?|taste|design)\b', re.I)
REASON = ('name the leaderboard role, not a model (LEADERBOARD.md). '
          'Budget limits are job counts or caps, never a model swap. '
          'use launch.sh --role review --made-by MODEL.')


def triage(raw, event):
    return any(word in raw for word in ('SendMessage', 'tell-general', 'lane-briefs',
                                       'Agent', 'claude', 'codex'))


RAW_CLAUDE_PIN = re.compile(r'(?m)(?:^|[;&|(]\s*)\s*(?:\S*/)?claude\b(?:(?!\s--\s)[^\n;&|])*?\s(?:--model[= ]|-m\s*)\S*(?:sonnet|haiku)', re.I)
RAW_CODEX_PIN = re.compile(r'(?m)(?:^|[;&|(]\s*)\s*(?:\S*/)?codex\s+exec\b(?:(?!\s--\s)[^\n;&|])*?\s(?:--model[= ]|-m\s*)\S+')


def commands(command):
    """Shell command segments, including pipelines and env prefixes."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=';&|()\n')
    lexer.whitespace = ' \t\r'
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        # 11-14: heredocs and quotes inside them leave shlex with an unclosed quote, and the hook then
        # failed closed on ordinary Bash calls. Fall back to a plain split, which still sees the words.
        tokens = re.findall(r'[;&|()\n]+|[^\s;&|()]+', command)
    segment = []
    for token in tokens + [';']:
        if token and all(c in ';&|()\n' for c in token):
            i = 0
            while i < len(segment) and (segment[i] in ('env', 'command', 'exec', 'sudo')
                                       or re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', segment[i])):
                i += 1
            if i < len(segment):
                yield segment[i:]
            segment = []
        else:
            segment.append(token)


def pinned_models(args):
    for i, arg in enumerate(args):
        if arg == '--':
            break
        if arg in ('--model', '-m') and i + 1 < len(args):
            yield args[i + 1]
        elif arg.startswith('--model='):
            yield arg.split('=', 1)[1]
        elif arg.startswith('-m') and len(arg) > 2:
            yield arg[2:]


def body(event):
    tool = event.get('tool_name')
    if tool not in ('SendMessage', 'Bash', 'Write', 'Edit', 'Agent'):
        return 0
    payload = event.get('tool_input')
    if not isinstance(payload, dict):
        raise ValueError('tool_input must be an object')
    texts = []
    if tool == 'Agent':
        model = payload.get('model', '')
        instructions = [payload.get(key, '') for key in ('description', 'prompt')]
        if not isinstance(model, str) or any(not isinstance(t, str) for t in instructions):
            raise ValueError('Agent model and instructions must be text')
        if CHEAP_MODEL.search(model) and any(JUDGMENT.search(t) for t in instructions):
            print(REASON, file=sys.stderr)
            return 2
    elif tool == 'SendMessage':
        texts = [payload['message']]
    elif tool == 'Bash':
        command = payload['command']
        for args in commands(command):
            name = Path(args[0]).name
            if name == 'tell-general':
                texts.append(' '.join(args[1:]))
            if JUDGMENT.search(command):
                if ((name == 'claude' and any(CHEAP_MODEL.search(m) for m in pinned_models(args[1:])))
                        or (name == 'codex' and args[1:2] == ['exec']
                            and any(pinned_models(args[2:])))):
                    print(REASON, file=sys.stderr)
                    return 2
        # Quotes that balance by accident across a heredoc merge commands into one token, so the
        # segments above can miss a pinned launch. A line-level pass sees it regardless of quoting.
        if JUDGMENT.search(command) and (RAW_CLAUDE_PIN.search(command) or RAW_CODEX_PIN.search(command)):
            print(REASON, file=sys.stderr)
            return 2
    else:
        path = payload['file_path']
        if not isinstance(path, str):
            raise ValueError('file_path must be text')
        if 'lane-briefs' in Path(path).parts:
            texts = [payload['content' if tool == 'Write' else 'new_string']]
    for text in texts:
        if not isinstance(text, str):
            raise ValueError('outgoing text must be text')
        # A wrapped line is still the same sentence; dots between digits are versions.
        for sentence in re.split(r'[!?]+|(?<!\d)\.|\.(?!\d)', text):
            if MODEL.search(sentence) and JUDGMENT.search(sentence):
                print(REASON, file=sys.stderr)
                return 2
    return 0


if __name__ == '__main__':
    sys.exit(_hookfail.run('model-instruction-gate', body, triage,
                          guards='judgment instructions in messages, Agent, Bash and lane-briefs'))
