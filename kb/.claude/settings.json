{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git add -A:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-tree.sh\"",
            "timeout": 10,
            "statusMessage": "Checking main-tree guard"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__computer|mcp__claude-in-chrome__browser_batch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/friend-reply-gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking email reply gate"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__computer|mcp__claude-in-chrome__browser_batch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/voice-send-gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking voice send gate"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__send_message|mcp__claude_ai_Gmail__create_draft|mcp__claude_ai_Gmail__update_draft|mcp__claude_ai_Gmail__reply|mcp__claude_ai_Gmail__forward",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/email-voice-gate.py\"",
            "timeout": 60,
            "statusMessage": "Checking email voice gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-title-index.sh\"",
            "timeout": 15,
            "statusMessage": "Loading KB title index"
          }
        ]
      }
    ]
  }
}
