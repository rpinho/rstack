<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ricardo.x-hot-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>export PATH="$HOME/.local/bin:$HOME/.local/share/research-harness/rstack/tools:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"; exec "$HOME/.local/share/research-harness/rstack/tools/x-hot-watch"</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/ricardo/.local/state/x-hot-watch/launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/ricardo/.local/state/x-hot-watch/launchd.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
