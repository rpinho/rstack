RESET_MSG = ("Harness check (lane-nudge): the Claude weekly limit reset at {at}. If this session stopped at the "
             "limit, resume now: read your state or handoff file and continue your open work.")
RESET_DELAY = 5 * 60          # wake 5 minutes after the reset, not on its first second
RESET_STALE = 12 * 3600       # a reset noticed more than 12 h late is not announced


def usage_resets(usage_dir):
    """Weekly reset times (epoch, to the minute) named by the usage snapshot and its history, and one week before
    each, so the reset that just passed is known even after claude-usage has moved on to the next one."""
    d = Path(os.path.expanduser(usage_dir))
    rows = []
    try:
        rows.append(json.loads((d / 'claude.json').read_text()))
    except (OSError, ValueError):
        pass
    try:
        for line in (d / 'claude-history.jsonl').read_text().splitlines()[-500:]:
            try:
                rows.append(json.loads(line))
            except ValueError:
                pass
    except OSError:
        pass
    out = set()
    for r in rows:
        try:
            t = datetime.fromisoformat(str(r['resets_at']).replace('Z', '+00:00')).timestamp()
        except (KeyError, TypeError, ValueError):
            continue
        t = round(t / 60) * 60
        out.update((t, t - 7 * 86400))
    return out


def reset_due(resets, done, now, delay=RESET_DELAY, stale=RESET_STALE):
    """The latest reset at least `delay` s ago that is newer than `done` and under `stale` s old, else None."""
    passed = [t for t in resets if t + delay <= now]
    t = max(passed) if passed else None
    return t if t is not None and t > done and now - t < stale else None


def reset_wake(a, registry, state, now):
    """One resume prompt per idle Claude session, once per weekly reset. The first run only records the last
    reset, so installing it wakes nobody."""
    sf = state / 'weekly-reset.json'
    with open(state / 'weekly-reset.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return                                  # the other copy is announcing it
        resets = usage_resets(a.usage)
        try:
            done = float(json.loads(sf.read_text())['done'])
        except (OSError, ValueError, KeyError, TypeError):
            if not a.dry:
                sf.write_text(json.dumps({'done': max([t for t in resets if t <= now], default=0), 'at': now}))
            return
        t = reset_due(resets, done, now)
        if t is None:
            return
        at = datetime.fromtimestamp(t, timezone.utc).strftime('%Y-%m-%d %H:%MZ')
        skip = {s for s in a.reset_skip.split(',') if s}
        lanes_root = getattr(a, 'lanes', None)
        for session, pane, _ in panes(a.tmux, a.prefix):
            lane = registry.lane_of_session(session)
            if session in skip or registry.status(lane) in ('retired', 'ended', 'held'):
                continue
            if lanes_root and active_driver(Path(os.path.expanduser(lanes_root)) / lane, a.tmux, state):
                continue
            tail = subprocess.run([a.tmux, 'capture-pane', '-p', '-t', pane, '-S', '-15'],
                                  capture_output=True, text=True).stdout
            if RUNNING.search(tail):
                say(a.log, f'{a.prefix}{session}: weekly reset {at}, already running', a.dry)
                continue
            say(a.log, f'{a.prefix}{session}: weekly-reset wake ({at})', a.dry)
            if not a.dry:
                type_into(a.tmux, pane, RESET_MSG.format(at=at))
        if not a.dry:
            sf.write_text(json.dumps({'done': t, 'at': now}))


RESULT_MSG = ("Harness check (lane-nudge): a job result for lane {lane} landed after your last turn and nothing woke "
              "you: {path}. Read it and take the next step now. Then check why your watcher missed it (the file it "
              "watched, or a missing rule) and fix that rule.")


def pickup(row):
    """11-11: the digest -> lane loop. Name the newest digest idea no round has picked up, so the
    next round starts there (rh lanes cadence reports it as digest.newest_unrun)."""
    idea = ((row or {}).get('digest') or {}).get('newest_unrun')
    if not idea:
        return ''
    return (' Start from the newest digest idea no round has picked up: {} ({}). Promote or freeze it when '
            'the round starts and log its result or close it with the verdict, so idea -> round -> verdict '
            'shows in rh lanes cadence.'.format(idea['id'], idea.get('claim', '')[:140]))


def decide(idle_min, running, status, last_nudge, now, idle_limit=60, reask=7200, unread=None, last_output=None,
           blocked=None, quiet=None):
    """Return the reason to nudge, or None. Pure, so it can be tested without tmux.

    unread: a job output newer than the session's last real turn (see unread_output). It overrides
    `running` and the idle limit: 11-12, math waited on its own watcher shell for 5.5 h after its review
    had finished, and that shell is exactly what made the pane look busy. One nudge per output file."""
    if status in ('EXEMPT', 'UNCONFIGURED', 'HELD'):    # HELD: lanes/<lane>/HOLD, paused by its owner
        return None
    if unread and unread != last_output:
        return 'a job result landed after your last turn and nothing woke you: {}'.format(unread)
    if blocked or quiet:    # the unread result above still wakes the lane
        return None
    if running or idle_min < idle_limit or now - last_nudge < reask:
        return None
    return f'{status} on cadence' if status in BEHIND else 'quiet'


def unread_output(globs, lane, last_turn, now, settle=15 * 60):
    """The newest job output (from the --outputs globs, {lane} filled in) written after last_turn and at
    least `settle` seconds ago, or None. Finished-job files only (a .last.md, a review's final text, a
    watch event): a live log changes all the time and would always look newer."""
    newest, best = None, None
    for pattern in globs:
        for f in glob.glob(os.path.expanduser(pattern.replace('{lane}', lane))):
            try:
                m = os.path.getmtime(f)
            except OSError:
                continue
            if last_turn < m <= now - settle and (best is None or m > best):
                newest, best = f, m
    return newest


BLOCKED_HOURS = 12


def blocked_on(lane_dir, now, hours=BLOCKED_HOURS):
    """The first line of lanes/<lane>/BLOCKED when it was written in the last `hours`, else None.

    friends, 11-13: blocked on seven decisions only the owner can make, every in-brief job done, and nudged
    three times in a night to "keep working on something else", which only invites busywork. A lane writes
    BLOCKED (first line: the decision it waits on and where it was sent) and deletes it once answered.
    It lapses after `hours` so a forgotten one cannot silence a lane; rewrite it to stay blocked."""
    path = Path(lane_dir) / 'BLOCKED'
    try:
        if now - path.stat().st_mtime > hours * 3600:
            return None
        return (path.read_text(errors='replace').strip().splitlines() or ['(no reason given)'])[0][:200]
    except OSError:
        return None


def warn_quiet(lane_dir, state, now, reason):
    """Warn at most once per lane per UTC day, even if scheduled runs overlap."""
    warned = state / f'{lane_dir.name}.quiet-warned'
    today = datetime.fromtimestamp(now, timezone.utc).date().isoformat()
    try:
        with warned.open('a+', encoding='ascii', errors='replace') as fh:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            fh.seek(0)
            if fh.read() == today:
                return
            fh.seek(0)
            fh.truncate()
            fh.write(today)
    except OSError:
        pass  # a warning cache that cannot be written must still allow the warning
    harness_blocks.warn('lane-nudge.quiet', f'{lane_dir / "QUIET"}: {reason}', lane=lane_dir.name)


def quiet_until(lane_dir, state, now):
    """Read the first line of QUIET and return it only while the UTC expiry is in the future."""
    try:
        with (lane_dir / 'QUIET').open('rb') as fh:
            line = fh.readline().decode('utf-8').strip()
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError) as exc:
        warn_quiet(lane_dir, state, now, f'could not read marker ({type(exc).__name__})')
        return None

    match = re.fullmatch(r'until (\S+) by .+: .+', line)
    try:
        expires = datetime.fromisoformat(match[1].replace('Z', '+00:00')) if match else None
    except ValueError:
        expires = None
    if expires is None or expires.tzinfo != timezone.utc:
        warn_quiet(lane_dir, state, now, 'expected until <ISO 8601 UTC> by <who>: <why> on the first line')
        return None
    if expires.timestamp() <= now:
        warn_quiet(lane_dir, state, now, f'marker expired at {match[1]}')
        return None
    return line[:200]


def tell_session():
    """rstack/tools/tell-session, installed (<root>/rstack) or in the repo, else on PATH; None if absent."""
    here = Path(__file__).resolve()
    for p in (here.parents[2] / 'rstack/tools/tell-session', here.parents[3] / 'rstack/tools/tell-session',
              Path(shutil.which('tell-session') or '/nonexistent')):
        if p.is_file():
            loader = importlib.machinery.SourceFileLoader('tell_session', str(p))
            mod = importlib.util.module_from_spec(importlib.util.spec_from_loader('tell_session', loader))
            loader.exec_module(mod)
            return mod
    return None


def type_into(tmux, pane, text):
    """Type and confirm through tell-session (11-26: text and Enter sent blind sat unsubmitted for hours)."""
    ts = tell_session()
    if ts is None:  # fail open: send as before, and say so
        print('lane-nudge: tell-session not found; sent without confirming', file=sys.stderr)
        subprocess.run([tmux, 'send-keys', '-t', pane, '-l', '--', text])
        time.sleep(1)
        subprocess.run([tmux, 'send-keys', '-t', pane, 'Enter'])
        return True
    code, msg = ts.tell(pane, text, tmux=tmux, sleep=time.sleep)
    if code:
        print(msg, file=sys.stderr)
    return code == 0


def read_driver_status(lane_dir, state=None):
    paths = [Path(lane_dir) / 'DRIVER_STATUS.md']
    if state is not None:
        paths.append(Path(state).parent / Path(lane_dir).name / 'DRIVER_STATUS.md')
    for path in paths:
        try:
            mtime = path.stat().st_mtime
            return path.read_text(errors='replace'), mtime
        except OSError:
            continue
    return '', None


def driver_status(lane_dir, state=None):
    """Read DRIVER_STATUS.md -> (session_name, quota_stopped, mtime), or (None, False, None)."""
    text, mtime = read_driver_status(lane_dir, state)
    if mtime is None:
        return None, False, None
    m = DRIVER_RE.search(text)
    stopped = any(QUOTA_LINE.search(ln) and not QUOTA_OK.search(ln) for ln in text.splitlines())
    return (m.group(1) if m else 'agy-' + Path(lane_dir).name), stopped, mtime


def driver_pane(tmux, name):
    """Return the first pane id of tmux session `name`, or None when missing."""
    r = subprocess.run([tmux, 'list-panes', '-t', '=' + name, '-F', '#{pane_id}'],
                       capture_output=True, text=True)
    lines = [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]
    return lines[0] if getattr(r, 'returncode', 0) == 0 and lines else None


def active_driver(lane_dir, tmux, state=None):
    """Return (session_name, pane_id, mtime) when DRIVER_STATUS.md names a live, non-quota-stopped driver."""
    name, stopped, mtime = driver_status(lane_dir, state)
    if stopped and name and state is not None and switch_state(state, name).get('to'):
        stopped = False                  # the quota note is Gemini's; lane-nudge moved the driver onto Claude
    pane = driver_pane(tmux, name) if name and not stopped else None
    return (name, pane, mtime) if pane else None


def switch_state(state, name):
    try:
        return json.loads((Path(state) / f'{name}.agy-switch.json').read_text())
    except (OSError, ValueError):
        return {}


def above_prompt(screen, n=6):
    """The last n non-blank lines above agy's input box (the separator over the last `>` line), joined."""
    lines = screen.splitlines()
    prompt = max((i for i, ln in enumerate(lines) if ln.lstrip().startswith('>')), default=len(lines))
    top = max((i for i in range(prompt) if lines[i].lstrip().startswith('─')), default=prompt)
    return ' '.join([ln.strip() for ln in lines[:top] if ln.strip()][-n:])


def shown_model(screen):
    """The model agy's status line shows ('Claude Opus 5.5'), or None."""
    found = AGY_MODEL.findall(screen)
    return found[-1].strip() if found else None


def slug(shown):
    return re.sub(r'[\s.]+', '-', shown.strip().lower())


def conversation_of(pid):
    """The pane's agy conversation: the conversations/<id>.db its process holds open, else the last one its own
    log names; None when neither. 11-26: `agy -c` resumed the newest conversation on the machine, a health probe's,
    not the pane's own, and an idle process does not always hold its db open."""
    lsof = shutil.which('lsof') or '/usr/sbin/lsof'
    out = subprocess.run([lsof, '-Fn', '-p', str(pid)], capture_output=True, text=True).stdout if pid else ''
    ids = re.findall(r'/conversations/([0-9a-f-]{36})\.db$', out, re.M)
    for log in [] if ids else re.findall(r'^n(/.*/log/cli-[\w.-]+\.log)$', out, re.M)[:1]:
        try:
            ids = re.findall(r'(?:cascade_id:|conversation )([0-9a-f-]{36})', Path(log).read_text(errors='replace'))
        except OSError:
            pass
    return ids[-1] if ids else None


def respawn(a, pane, path, model, effort, conv):
    """Restart the pane's agy on `model`, holding conversation `conv`; True once its status line shows that model
    at a ready prompt. A workspace-trust prompt gets Enter only."""
    cmd = [a.agy, '--model', model, '--effort', effort, '--dangerously-skip-permissions']
    cmd += ['--conversation', conv] if conv else []
    if subprocess.run([a.tmux, 'respawn-pane', '-k', '-t', pane] + (['-c', path] if path else []) + [shlex.join(cmd)],
                      capture_output=True, text=True).returncode:
        return False
    for _ in range(40):
        time.sleep(3)
        screen = subprocess.run([a.tmux, 'capture-pane', '-p', '-t', pane], capture_output=True, text=True).stdout
        if AGY_TRUST.search(screen):
            subprocess.run([a.tmux, 'send-keys', '-t', pane, 'Enter'])
            continue
        shown = shown_model(screen)
        if shown and model.startswith(slug(shown)) and '? for shortcuts' in screen:
            return True
    return False


def agy_switch(a, lane, lane_dir, state, now):
    """11-27 Ricardo: "why are we using that? we obviously have a Claude subscription. I think we should focus on
    Neon when using agy." agy runs Gemini only. A Gemini quota stop hands the lane to its Claude Code fallback
    (takeover); after the reset the agy pane is respawned on its own Gemini model (Neon when unknown) and the
    fallback is told to hand back. A pane found on agy's Claude (the 11-26 rule) is treated as stopped until Neon's
    block ends, then moved back. Returns 'switched' (handled this run), 'stopped' (the Claude fallback drives) or
    None (no quota stop; route as usual)."""
    import agy_quota
    name, noted, mtime = driver_status(lane_dir, state)
    pane = driver_pane(a.tmux, name) if name else None
    if not pane:
        return None
    sf = state / f'{name}.agy-switch.json'
    sw = switch_state(state, name)
    screen = subprocess.run([a.tmux, 'capture-pane', '-p', '-t', pane, '-S', '-15'],
                            capture_output=True, text=True).stdout
    info = subprocess.run([a.tmux, 'display-message', '-p', '-t', pane,
                           '#{pane_start_command}\t#{pane_current_path}\t#{pane_pid}'],
                          capture_output=True, text=True).stdout.strip().split('\t')
    start, path, pid = (info + ['', '', ''])[:3]
    shown = shown_model(screen) or ''
    on_claude = shown.startswith('Claude') or '--model claude' in start
    block = above_prompt(screen)
    waiting = WATCHER_WAIT.search(block)
    quota = AGY_QUOTA.search(block) and (waiting or not re.search(r'esc to (?:interrupt|cancel)', screen))
    found = re.search(r'--model[ =]["\']?([\w.-]+)', start)
    model = sw.get('from') or (found.group(1) if found and not found.group(1).startswith('claude') else None) \
        or (slug(shown) if shown and not on_claude else None) or AGY_GEMINI
    if 'neon' not in model:
        model = AGY_GEMINI              # 11-27 Ricardo: "GEMINI = NEON ONLY"; a Carbon/Argon/Hydrogen pane comes back on Neon
    found = re.search(r'--effort[ =]["\']?(\w+)', start)
    effort = sw.get('effort') or (found.group(1) if found else 'high')
    reset_at = sw.get('reset')
    blocked = None
    if waiting or on_claude or sw.get('stopped'):
        # The quota ledger wins over an older reset guess: never respawn onto a Gemini model that is still out.
        quota_table = agy_quota.blocked(now=datetime.fromtimestamp(now, timezone.utc))
        row = agy_quota.blocked_until(model, effort, table=quota_table)
        if not row and (tier := agy_quota.tier_of(model, effort)):
            suffix = '-' + tier
            alias = model.removesuffix(suffix) if model.endswith(suffix) else model + suffix
            row = agy_quota.blocked_until(alias, tier, table=quota_table)
        try:
            blocked = datetime.fromisoformat(str(row['blocked_until']).replace('Z', '+00:00')).timestamp() if row else None
        except (KeyError, TypeError, ValueError):
            pass
    if on_claude or sw.get('stopped'):
        reset_at = max(reset_at or now, blocked or 0) if (reset_at or blocked) else now
    if reset_at and now >= reset_at and (on_claude or sw.get('stopped')) and (waiting or not RUNNING.search(screen)):
        if idled(lane_dir, state, now):
            return 'stopped'
        reset = datetime.fromtimestamp(reset_at, timezone.utc).strftime('%Y-%m-%d %H:%MZ')
        model, effort = driver_effort(model, effort)   # the stop above is recorded at the effort the pane ran
        say(a.log, f'{name}: Gemini quota back (reset {reset}); moving agy back to {model} at {effort}', a.dry)
        if not driver_slot(a, lane, now):
            say(a.log, f'{name}: {os.environ.get("RH_AGY_MAX_DRIVERS", "3")} agy drivers already run here; '
                       'the Claude fallback keeps driving (RH_AGY_MAX_DRIVERS)', a.dry)
            return 'stopped'
        if a.dry:
            return 'switched'
        if not respawn(a, pane, path, model, effort, conversation_of(pid)):
            say(a.log, f'{name}: respawn on {model} failed; the Claude fallback keeps driving')
            return 'stopped'
        sf.write_text(json.dumps({'from': model, 'effort': effort, 'back_at': now}))
        type_into(a.tmux, pane, BACK_MSG.format(reset=reset, model=model))
        fallback = f'{a.prefix}{lane}'
        if subprocess.run([a.tmux, 'has-session', '-t', f'={fallback}'], capture_output=True).returncode == 0:
            type_into(a.tmux, f'={fallback}:', HANDBACK_MSG.format(lane=lane, model=model))
        (state / f'{lane}.takeover.json').unlink(missing_ok=True)
        return 'switched'
    if on_claude or (reset_at and now < reset_at and sw.get('stopped')):
        return 'stopped'
    watcher_blocked = waiting and blocked and now < blocked
    if not quota and not watcher_blocked and not (noted and mtime > sw.get('back_at', 0)):
        return None
    text = block if quota else 'DRIVER_STATUS.md quota note'
    seconds = agy_quota.reset_seconds(text)
    reset_at = blocked if watcher_blocked else now + (seconds if seconds is not None else agy_quota.FIVE_HOURS)
    reset = datetime.fromtimestamp(reset_at, timezone.utc).strftime('%Y-%m-%d %H:%MZ')
    say(a.log, f'{name}: Gemini quota stop on {model} (reset {reset}{"" if watcher_blocked or seconds is not None else ", assumed"}); '
               'handing the lane to its Claude Code fallback (agy never runs Claude)', a.dry)
    if a.dry:
        return 'stopped'
    sf.write_text(json.dumps({'from': model, 'effort': effort, 'at': now, 'reset': reset_at, 'stopped': True,
                              'back_at': sw.get('back_at', 0)}))
    if watcher_blocked:
        return 'stopped'  # The quota ledger already has this stop and reset.
    try:
        import run_records
        tier = model if agy_quota.tier_of(model) else f'{model}-{effort}'
        run_records.record_quota({'run_id': f'lane-nudge-{name}-{int(now)}', 'model': tier, 'lane': lane,
                                  'utc': datetime.fromtimestamp(now, timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')},
                                 text)
    except Exception as exc:                        # RULE #1: the record never stops the handover
        say(a.log, f'{name}: quota record failed: {exc!r}')
    return 'stopped'

def panes(tmux, prefix):
    out = subprocess.run([tmux, 'list-panes', '-a', '-F', '#{session_name}\t#{pane_id}\t#{pane_current_path}'],
                         capture_output=True, text=True).stdout
    for row in out.splitlines():
        name, pane, path = row.split('\t')
        if name.startswith(prefix):
            yield name[len(prefix):], pane, path


def transcripts(path, projects, now, recent=2 * 86400):
    """Transcripts for a pane: those Claude Code files under the pane's directory, plus recent ones whose
    latest recorded cwd is the pane's (a session that cd'd after launch files under its launch directory)."""
    d = projects / re.sub(r'[/.]', '-', path)
    found = list(d.glob('*.jsonl')) if d.is_dir() else []
    needle = '"cwd":' + json.dumps(path)
    for f in projects.glob('*/*.jsonl'):
        if f in found or now - f.stat().st_mtime > recent:
            continue
        cwds = re.findall(r'"cwd":"[^"]*"', tail_text(f, 1 << 16))
        if cwds and cwds[-1] == needle:
            found.append(f)
    return found


def tail_text(f, size):
    with open(f, 'rb') as fh:
        fh.seek(0, 2)
        fh.seek(max(0, fh.tell() - size))
        return fh.read().decode('utf-8', 'replace')


def real_turn(row):
    """A message someone sent or the model wrote. Not compaction (its boundary and summary rows carry fresh
    timestamps), not meta rows, not the untimestamped title/mode/bridge rows a session rewrites while idle."""
    return (row.get('type') in ('user', 'assistant') and not row.get('isCompactSummary')
            and not row.get('isMeta') and not row.get('isSidechain') and bool(row.get('timestamp')))


def last_turn(f, chunk=1 << 20):
    """Epoch seconds of the newest real turn in transcript f, or None. Reads from the end, widening the
    window until it finds one, so a multi-GB transcript costs one chunk."""
    size = f.stat().st_size
    window = chunk
    while True:
        lines = tail_text(f, window).split('\n')   # not splitlines(): U+2028 inside JSON splits a record
        if window < size:
            lines = lines[1:]      # the first line of a partial window is cut
        for line in reversed(lines):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and real_turn(row):
                try:
                    return datetime.fromisoformat(row['timestamp'].replace('Z', '+00:00')).timestamp()
                except ValueError:
                    continue
        if window >= size:
            return None
        window *= 4


def idle_minutes(path, projects, now):
    """Minutes since the newest real turn across the pane's transcripts, or None when there is none."""
    turns = [t for t in (last_turn(f) for f in transcripts(path, projects, now)) if t is not None]
    return int((now - max(turns)) / 60) if turns else None


def cadence(rh):
    """({owner_session: row}, None) or (None, error). A failed read is never all clear: one Mini ran
    this under launchd with a bare `rh` that was not on launchd's PATH, every read failed for 8 hours,
    and every lane read as fine. `rh lanes cadence` exits 1 when a lane is behind, so only output that
    is not the JSON list counts as a failed read."""
    try:
        run = subprocess.run([rh, 'lanes', 'cadence', '--json'], capture_output=True, text=True, timeout=120)
        try:
            data = json.loads(run.stdout)
        except ValueError:
            return None, 'exit {}, no JSON: {}'.format(run.returncode, (run.stderr or run.stdout).strip()[-200:])
        rows = {r['owner_session']: r for r in data if isinstance(r, dict) and r.get('owner_session')}
        return (rows, None) if rows else (None, 'no lanes in the cadence output')
    except (OSError, subprocess.SubprocessError) as exc:
        return None, '{}: {}'.format(type(exc).__name__, exc)


def report_failure(error, state, alert, dry):
    """Print a loud row on every failed run and push once per failure streak (ALERT, a command that
    takes the message as its last argument); log recovery the same way."""
    flag = state / 'cadence-failed.json'
    if error:
        line = 'CADENCE READ FAILED: {}. Every lane is UNKNOWN this run, not fine.'.format(error)
        print(line, file=sys.stderr)
        if not flag.exists() and not dry:
            if alert:
                subprocess.run(shlex.split(alert) + ['lane-nudge: ' + line], capture_output=True, timeout=60)
            flag.write_text(json.dumps({'since': time.time(), 'error': error}))
        return line
    if flag.exists() and not dry:
        if alert:
            subprocess.run(shlex.split(alert) + ['lane-nudge: cadence read recovered'], capture_output=True, timeout=60)
        flag.unlink()
    return None


def say(log, line, dry=False):
    print(line)
    if log and not dry:
        with open(os.path.expanduser(log), 'a') as fh:
            fh.write(time.strftime('%Y-%m-%d %H:%M:%S ') + line + '\n')


TAKEOVER_MSG = ("Harness check (lane-nudge): agy-{lane} is out of its Gemini quota (agy runs Gemini only, never Claude). "
                "You are {lane}'s driver now, as its Claude Code fallback, until the reset: continue the lane from "
                "DRIVER_STATUS.md, put bounded work on background jobs and arm a watcher on each one.")
TAKEOVER_EVERY = 12 * 3600


def takeover(a, session, lane, lane_dir, pane, state, run=subprocess.run, sleep=time.sleep, now=None):
    """11-27: the log said "waking the Claude fallback" every 30 min while nothing woke: lean-svm and paper-audit
    had no fallback session, and meccog's idle one only got the usual idle check. When agy is out of both groups,
    start claude-<lane> if it is missing (in the lane's KB worktree, else the lane dir) and hand it the lane once
    per TAKEOVER_EVERY. Returns (pane, handed); pane is None when it could not be started (logged; RULE #1)."""
    now = time.time() if now is None else now
    name = f'{a.prefix}{session}'
    if pane is None:
        # LANE_NUDGE_FALLBACK_DIR (host env file; "{lane}" is replaced): where the other fallbacks run, e.g. a
        # per-lane worktree. Unset or missing: the lane dir.
        pattern = os.environ.get('LANE_NUDGE_FALLBACK_DIR', '')
        wanted = Path(os.path.expanduser(pattern.replace('{lane}', lane))) if pattern else None
        cwd = wanted if wanted and wanted.is_dir() else lane_dir
        cmd = 'env -u CLAUDE_CODE_OAUTH_TOKEN {} --permission-mode bypassPermissions --remote-control {} --name {}'.format(
            shlex.quote(str(Path.home() / '.local/bin/claude')), shlex.quote(lane), shlex.quote(lane))
        if run([a.tmux, 'new-session', '-d', '-s', name, '-c', str(cwd), cmd], capture_output=True, text=True).returncode:
            say(a.log, f'{name}: could not start the Claude fallback')
            return None, False
        say(a.log, f'{name}: started the Claude fallback in {cwd}')
        pane = f'={name}:'
        for _ in range(30):
            sleep(2)
            screen = run([a.tmux, 'capture-pane', '-p', '-t', pane], capture_output=True, text=True).stdout or ''
            if 'trust this folder' in screen:     # the lane's own folder: Claude Code's workspace-trust question
                run([a.tmux, 'send-keys', '-t', pane, 'Down'], capture_output=True)
                run([a.tmux, 'send-keys', '-t', pane, 'Enter'], capture_output=True)
                continue
            if 'bypass permissions on' in screen:
                break
    mark = state / f'{lane}.takeover.json'
    try:
        last = json.loads(mark.read_text()).get('at', 0)
    except (OSError, ValueError):
        last = 0
    if now - last >= TAKEOVER_EVERY and type_into(a.tmux, pane, TAKEOVER_MSG.format(lane=lane)):
        mark.write_text(json.dumps({'at': now, 'pane': pane}))
        say(a.log, f'{name}: handed the lane (agy out of both quota groups)')
        return pane, True
    return pane, False


LEADS_MSG = ("Harness (lane-nudge): new bookmark leads for {lane} are in {path} ({n} leads, from Ricardo's bookmarks "
             "via the nightly digest). Read them, take the ones that fit this lane's ask, and log what you picked up "
             "or why not.")
CANDIDATES_MSG = ("Harness (lane-nudge): new-lane candidates from Ricardo's bookmarks are in {path} ({n} rows): ideas no "
                  "active lane owns. Route each to the closest lane, propose a new lane to general, or drop it with a "
                  "reason.")


def deliver_leads(a, lane, pane, state, now, days=2):
    """11-27 (Ricardo: "the bookmark ingest and the morning digest should all be contributing to those lanes
    automatically"): the nightly writes <lane>-<YYYY-MM-DD>.md into LANE_LEADS_DIR (one file per lane per day,
    new-lane-candidates-<day>.md for ideas no lane owns, which go to the harness lane). Each file is typed to the
    lane's driver once, the first quiet tick after it appears. Returns True when it sent one."""
    leads = Path(os.path.expanduser(os.environ.get('LANE_LEADS_DIR', '~/.local/share/lane-briefs/leads')))
    if not leads.is_dir():
        return False
    mark = state / f'{lane}.leads.json'
    try:
        done = set(json.loads(mark.read_text()).get('delivered', []))
    except (OSError, ValueError):
        done = set()
    prefixes = [(f'{lane}-', LEADS_MSG)] + ([('new-lane-candidates-', CANDIDATES_MSG)] if lane == 'harness' else [])
    for prefix, msg in prefixes:
        for f in sorted(leads.glob(prefix + '*.md')):
            day = f.name[len(prefix):-3]
            if f.name in done or not re.fullmatch(r'\d{4}-\d{2}-\d{2}', day) or now - f.stat().st_mtime > days * 86400:
                continue
            n = sum(1 for line in f.read_text(errors='replace').splitlines() if line.lstrip().startswith(('- ', '* ')))
            if not type_into(a.tmux, pane, msg.format(lane=lane, path=f, n=n)):
                say(a.log, f'{lane}: lead file {f.name} not confirmed in the pane; retried next run')
                return False
            done.add(f.name)
            mark.write_text(json.dumps({'delivered': sorted(done)[-60:]}))
            say(a.log, f'{lane}: handed {f.name} ({n} leads)')
            return True
    return False


def idled(lane_dir, state, now=None):
    """Why the lane is idled on purpose (an active QUIET, or "idle by design" in DRIVER_STATUS.md), else ''."""
    now = time.time() if now is None else now
    q = quiet_until(lane_dir, state, now)
    if q:
        return f'QUIET {q}'
    text, _ = read_driver_status(lane_dir, state)
    for line in text.splitlines():
        if IDLE_BY_DESIGN.search(line):
            until = IDLE_UNTIL.search(line)
            if until:
                try:
                    if datetime.fromisoformat(until.group(1) + '+00:00').timestamp() <= now:
                        continue
                except ValueError:
                    pass
            return 'idle by design'
    return ''


LIVENESS_HOURS = 2.0
IDLE_BY_DESIGN = re.compile(r'idle by design', re.I)
IDLE_UNTIL = re.compile(r'idle by design until (\d{4}-\d\d-\d\d[T ]\d\d:\d\d(?::\d\d)?)(?:Z|\+00:00|\s*UTC)', re.I)
PROMPT = re.compile(r'\? for shortcuts|bypass permissions on|^\s*[>❯›]\s*$', re.M)


def lane_output_time(lane, lane_dir, globs, repos, run=subprocess.run):
    """Newest OUTPUT time for a lane (memory lane-heartbeat-is-output): DRIVER_STATUS.md, RESULTS.jsonl, watch
    events, finished job outputs (--outputs globs) and the newest commit in its repos. Not what the driver says."""
    times = []
    for f in [lane_dir / 'DRIVER_STATUS.md', lane_dir / 'RESULTS.jsonl', *lane_dir.glob('watch/events/*')]:
        try:
            times.append(f.stat().st_mtime)
        except OSError:
            pass
    for pattern in globs:
        for f in glob.glob(os.path.expanduser(pattern.replace('{lane}', lane))):
            try:
                times.append(os.path.getmtime(f))
            except OSError:
                pass
    for repo in [lane_dir, *repos]:
        repo = Path(os.path.expanduser(str(repo)))
        if (repo / '.git').exists():
            r = run(['git', '-C', str(repo), 'log', '-1', '--format=%ct', '--all'], capture_output=True, text=True)
            if r.returncode == 0 and r.stdout.strip().isdigit():
                times.append(float(r.stdout.strip()))
    return max(times) if times else None


def pane_state(tmux, sessions, run=subprocess.run):
    """What the lane's driver panes show: quota, menu, prompt, working or missing (for the alarm's text)."""
    ts = tell_session()
    shown = []
    for name in sessions:
        r = run([tmux, 'capture-pane', '-p', '-t', f'={name}:'], capture_output=True, text=True)
        if r.returncode:
            continue
        lines = [ln for ln in (r.stdout or '').splitlines() if ln.strip()]
        tail = '\n'.join(lines[-12:])
        if AGY_QUOTA.search(tail):
            what = 'quota: ' + next((ln.strip() for ln in reversed(lines) if AGY_QUOTA.search(ln) or 'Resets in' in ln), '')[:120]
        elif ts is not None and ts.menu(r.stdout or ''):
            what = 'menu: ' + ts.menu(r.stdout or '')
        elif re.search(r'esc to (?:interrupt|cancel)', tail):
            what = 'working'
        elif RUNNING.search(tail) or re.search(r'\b\d+ shells?\b', tail):
            what = 'waiting on a background task or shell (a watcher that may never fire)'
        elif PROMPT.search(tail):
            what = 'prompt (idle, waiting for input)'
        else:
            what = 'unknown: ' + (lines[-1].strip()[:100] if lines else 'empty pane')
        shown.append(f'{name}: {what}')
    return '; '.join(shown) or 'no driver pane'


def liveness(a, registry, lanes_root, state, now, sessions, run=subprocess.run):
    """11-27 (Ricardo: "The whole point of rstack is that we're never blocked"): agy-open-source sat 7 h and lean-svm
    ~6 h before anyone noticed. A lane with a driver session on this Mac whose output has not moved for
    LANE_LIVENESS_HOURS (2), with no "idle by design" line in DRIVER_STATUS.md and no active QUIET, pages general
    (LANE_LIVENESS_PAGE, default tell-general break) and pushes Ricardo (LANE_LIVENESS_PUSH, default notify-ricardo)
    once per stall, naming the lane and what its pane shows. Repos per lane: LANE_LIVENESS_REPOS (a JSON file
    {"lane": ["path", ...]}, host-local). Returns the lanes it alarmed on."""
    hours = float(os.environ.get('LANE_LIVENESS_HOURS', '') or LIVENESS_HOURS)
    page = shlex.split(os.environ.get('LANE_LIVENESS_PAGE', 'tell-general break'))
    push = shlex.split(os.environ.get('LANE_LIVENESS_PUSH', 'notify-ricardo'))
    try:
        repos = json.loads(Path(os.path.expanduser(os.environ.get(
            'LANE_LIVENESS_REPOS', '~/.config/rstack/lane-liveness.json'))).read_text())
    except (OSError, ValueError):
        repos = {}
    by_lane = {}
    for name in sessions:
        kind, _, rest = name.partition('-')
        if kind in ('agy', 'claude', 'codex') and rest:
            by_lane.setdefault(registry.lane_of_session(rest), []).append(name)
    alarmed = []
    for lane, names in sorted(by_lane.items()):
        lane_dir = lanes_root / lane
        if not lane_dir.is_dir() or registry.status(lane) in ('retired', 'ended', 'held'):
            continue
        if idled(lane_dir, state, now):
            continue
        last = lane_output_time(lane, lane_dir, getattr(a, 'outputs_globs', []), repos.get(lane, []), run=run)
        mark = state / f'{lane}.liveness.json'
        try:
            seen = json.loads(mark.read_text())
        except (OSError, ValueError):
            seen = {}
        if last is not None and now - last < hours * 3600:
            if seen:
                mark.unlink()               # output moved: the stall is over, a new one alarms again
            continue
        if seen.get('last') == last:
            continue                        # this stall was already reported
        since = 'never' if last is None else '{:.1f} h ago'.format((now - last) / 3600)
        msg = ('lane-liveness: lane {} has produced no output for {:g}+ h (DRIVER_STATUS, RESULTS, job outputs, '
               'commits; last {}) and is not idle by design. Pane: {}').format(lane, hours, since,
                                                                             pane_state(a.tmux, names, run=run))
        if not a.dry:
            for cmd, text in ((page, msg), (push, msg[:300])):
                try:
                    run(cmd + [text], capture_output=True, text=True, timeout=60)
                except (OSError, subprocess.SubprocessError) as exc:
                    say(a.log, f'lane-liveness: could not run {cmd[0]}: {exc!r}')
            mark.write_text(json.dumps({'last': last, 'at': now}))
        say(a.log, msg, a.dry)
        alarmed.append(lane)
    return alarmed


def main():
    home = Path.home()
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('--prefix', default=os.environ.get('LANE_NUDGE_PREFIX', 'claude-'))
    ap.add_argument('--skip', default=os.environ.get('LANE_NUDGE_SKIP', ''),
                    help='comma-separated owner sessions that are idle by design')
    ap.add_argument('--idle-min', type=int, default=60)
    ap.add_argument('--reask', type=int, default=7200)
    default_tmux = str(home / '.local/bin/tmux') if (home / '.local/bin/tmux').exists() else 'tmux'
    ap.add_argument('--tmux', default=os.environ.get('TMUX_BIN') or default_tmux)
    ap.add_argument('--rh', default=os.environ.get('RH_BIN', 'rh'))
    default_agy = str(home / '.local/bin/agy') if (home / '.local/bin/agy').exists() else 'agy'
    ap.add_argument('--agy', default=os.environ.get('AGY_BIN') or default_agy,
                    help='agy binary, to restart a quota-stopped driver on Claude through agy')
    ap.add_argument('--projects', default=str(home / '.claude/projects'))
    ap.add_argument('--state', default=str(home / '.local/state/lane-nudge'))
    ap.add_argument('--alert', default=os.environ.get('LANE_NUDGE_ALERT', ''),
                    help='command run with one message argument when the cadence read fails (and on recovery)')
    ap.add_argument('--log', default=os.environ.get('LANE_NUDGE_LOG', ''), help='append each nudge to this file')
    ap.add_argument('--lanes', default=os.environ.get('LANE_NUDGE_LANES', '~/.local/share/research-harness/lanes'),
                    help='lanes root, for lanes/<lane>/BLOCKED and QUIET')
    ap.add_argument('--outputs', default=os.environ.get('LANE_NUDGE_OUTPUTS', ''),
                    help='comma-separated globs of finished-job outputs, {lane} for the lane name; one newer than '
                         "the session's last turn nudges it even while a watcher shell runs")
    ap.add_argument('--usage', default=os.environ.get('LANE_NUDGE_USAGE', '~/.local/state/rstack/usage'),
                    help="claude-usage's folder (claude.json, claude-history.jsonl), for the weekly reset")
    ap.add_argument('--reset-skip', default=os.environ.get('LANE_NUDGE_RESET_SKIP', ''),
                    help='comma-separated sessions not woken after the weekly reset (--skip does not apply)')
    ap.add_argument('--reset-only', action='store_true', help='only the weekly-reset wake, then exit')
    ap.add_argument('--dry', action='store_true')
    a = ap.parse_args()
    skip = {s for s in a.skip.split(',') if s}
    outputs = [g.strip() for g in a.outputs.split(',') if g.strip()]
    state = Path(a.state)
    state.mkdir(parents=True, exist_ok=True)
    registry = lane_registry.load(a.lanes)
    try:
        reset_wake(a, registry, state, time.time())
    except Exception as exc:                        # RULE #1: the wake never stops the idle nudges
        say(a.log, f'weekly-reset wake failed: {exc!r}', a.dry)
    if a.reset_only:
        return
    a.outputs_globs = outputs
    try:
        root = Path(os.path.expanduser(a.lanes))
        active = root.is_dir() and any(d.is_dir() and registry.status(registry.lane_of_session(d.name))
                                       not in ('retired', 'ended', 'held') for d in root.iterdir())
        if active:
            listed = subprocess.run([a.tmux, 'ls', '-F', '#{session_name}'], capture_output=True, text=True).stdout.split()
            liveness(a, registry, root, state, time.time(), listed)
    except Exception as exc:                        # RULE #1: the alarm never stops the idle nudges
        say(a.log, f'lane-liveness failed: {exc!r}', a.dry)
    cad, error = cadence(a.rh)
    failed = report_failure(error, state, a.alert, a.dry)
    if failed:
        say(a.log, failed, a.dry)
    cad = cad or {}
    lanes_root = Path(os.path.expanduser(a.lanes))
    targets = list(panes(a.tmux, a.prefix))
    seen = {registry.lane_of_session(s) for s, _, _ in targets}
    if lanes_root.is_dir():
        for marker in sorted(lanes_root.glob('*/DRIVER_STATUS.md')):
            if not marker.parent.is_symlink():
                lname = registry.lane_of_session(marker.parent.name)
                if lname not in seen:
                    targets.append((lname, None, None))
                    seen.add(lname)
    quiet, switched = {}, {}
    for session, pane, path in targets:
        lane = registry.lane_of_session(session)
        if registry.status(lane) in ('retired', 'ended', 'held'):
            say(a.log, f'{a.prefix}{session}: skipped ({registry.reason(lane)})', a.dry)
            continue
        if session in skip or lane in skip:
            continue
        lane_dir = lanes_root / lane
        if lane not in switched:
            try:
                switched[lane] = agy_switch(a, lane, lane_dir, state, time.time())
            except Exception as exc:                # RULE #1: the switch never stops the idle nudges
                switched[lane] = None
                say(a.log, f'{lane}: agy quota switch failed: {exc!r}', a.dry)
        if switched[lane] == 'switched':
            continue
        drv = None if switched[lane] == 'stopped' else active_driver(lane_dir, a.tmux, state)
        paused = idled(lane_dir, state) if switched[lane] == 'stopped' else ''
        if paused:
            # 11-27 (general, budget): a lane idled until the Claude reset (QUIET, or "idle by design" in
            # DRIVER_STATUS.md) is not handed to its Claude fallback; before, takeover started it again every 12 h.
            say(a.log, f'{lane}: agy stopped, but the lane is idled ({paused}); no Claude takeover', a.dry)
            continue
        elif switched[lane] == 'stopped' and not a.dry:
            try:
                started, handed = takeover(a, session, lane, lane_dir, pane, state)
                pane = started or pane
                if handed:
                    continue                        # the handover is this tick's message; no idle nudge on top
            except Exception as exc:                # RULE #1: a failed takeover never stops the idle nudges
                say(a.log, f'{lane}: Claude fallback takeover failed: {exc!r}')
        if not drv and pane is None:
            continue
        label = drv[0] if drv else f'{a.prefix}{session}'
        if lane not in quiet:
            quiet[lane] = quiet_until(lane_dir, state, time.time())
            if quiet[lane]:
                say(a.log, f'{label}: QUIET ({quiet[lane]}), idle nudge skipped', a.dry)
        now = time.time()
        if drv:
            target_pane, last_act = drv[1], drv[2]
            idle = max(0, int((now - last_act) / 60))
        else:
            target_pane = pane
            idle = idle_minutes(path, Path(a.projects), now)
            if idle is None:
                continue
            last_act = now - idle * 60
        tail = subprocess.run([a.tmux, 'capture-pane', '-p', '-t', target_pane, '-S', '-15'],
                              capture_output=True, text=True).stdout
        if not a.dry:
            gone = dismiss(a.tmux, target_pane, tail)
            if gone:
                say(a.log, f'{label}: dismissed {gone}')
                time.sleep(1)
                tail = subprocess.run([a.tmux, 'capture-pane', '-p', '-t', target_pane, '-S', '-15'],
                                      capture_output=True, text=True).stdout
        if not a.dry and not quiet[lane] and not RUNNING.search(tail):
            try:
                if deliver_leads(a, lane, target_pane, state, now):
                    continue                        # the leads are this tick's message; no idle nudge on top
            except Exception as exc:                # RULE #1: lead delivery never stops the idle nudges
                say(a.log, f'{label}: lead delivery failed: {exc!r}')
        sf = state / f'{drv[0] if drv else session}.json'
        saved = json.loads(sf.read_text()) if sf.exists() else {}
        last = saved.get('at', 0)
        c = cad.get(session, cad.get(lane, {}))
        unread = unread_output(outputs, lane, last_act, now) if outputs else None
        blocked = blocked_on(lane_dir, now)
        why = decide(idle, bool(RUNNING.search(tail)), c.get('status'), last, now, a.idle_min, a.reask,
                     unread, saved.get('output'), blocked, quiet[lane])
        if blocked and not why and idle >= a.idle_min:
            say(a.log, f'{label}: blocked, not nudged ({blocked})', True)
        if not why:
            continue
        if c.get('status') in BEHIND and c.get('deliverable'):
            why += ' ({}, {:.0f} h since the last one)'.format(c['deliverable'], c.get('hours_since_last_delivery') or 0)
        if c.get('last_sweep_refused'):
            why += '; the last sweep was REFUSED, not idle: ' + c['last_sweep_refused'] + '. Fix that first'
        if why == 'quiet' and (error or c.get('status') == 'UNKNOWN'):
            why = 'quiet (cadence unknown: the read failed)'
        text = (RESULT_MSG.format(lane=lane, path=unread) if unread and why.startswith('a job result')
                else MSG.format(lane=lane, why=why, idle=idle) + pickup(c))
        say(a.log, f'{label}: nudge ({why}; idle {idle} min)', a.dry)
        if a.dry:
            continue
        if not type_into(a.tmux, target_pane, text):
            say(a.log, f'{label}: nudge not confirmed in the pane; retried next run')
            continue
        sf.write_text(json.dumps({'at': time.time(), 'why': why, 'output': unread or saved.get('output')}))


if __name__ == '__main__':
    main()
