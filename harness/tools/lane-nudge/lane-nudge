BEHIND = ('WARN', 'STALLED', 'BROKEN')
RUNNING = re.compile(r'esc to (?:interrupt|cancel)|shells? still running|agents? running|still running|\b[1-9]\d* task\(s\)')
WATCHER_WAIT = re.compile(r'waiting (?:for|on) (?:the |a )?watcher|watcher armed|until \S*\.last\.md', re.I)
DRIVER_RE = re.compile(r'\b(agy-[A-Za-z0-9_.-]+)\b')
QUOTA_LINE = re.compile(r'\b(?:quota|rate[- ]?limit(?:ed)?)\b', re.I)
QUOTA_OK = re.compile(
    r'\b(?:no|none|zero)\s+\w*\s*(?:quota|rate[- ]?limit)|(?:quota|rate[- ]?limit)[^.\n]{0,20}\b(?:0|none|ok|clear)\b',
    re.I)
# 11-26: agy's own words on a quota stop ("Individual quota reached ... Resets in 2h11m36s."), never the /usage
# panel's "Refreshes in". Read only from the lines just above the input box, so an old one in scrollback is not news.
AGY_QUOTA = re.compile(r'Individual quota reached|exhausted your quota|weekly (?:limit|quota) reached|'
                       r'quota (?:reached|exceeded|exhausted)|RESOURCE_EXHAUSTED', re.I)
AGY_MODEL = re.compile(r'·\s*([A-Z][\w .-]*?)\s*·\s*(?:low|medium|high|xhigh|max)\b')   # "auto · Gemini 4 Neon · high"
AGY_TRUST = re.compile(r'Do you trust the contents of this project')
# 11-27: one-key menus that block a lane and have one harmless answer. lane-nudge answers them before anything else;
# a menu that is a real choice (Codex "c continue / n start fresh", y/n, numbered options) is never answered here.
# Add a row when a pane scan finds a new one: (pattern on the pane's last lines, key to send, what it is).
AUTO_DISMISS = [
    (re.compile(r'\[0\]\s*Skip'), '0', 'agy feedback survey'),
]


def dismiss(tmux, pane, screen, run=subprocess.run):
    """Answer a known harmless one-key menu on the pane's last lines. Returns what it dismissed, or None."""
    bottom = '\n'.join([ln for ln in screen.splitlines() if ln.strip()][-6:])
    for rx, key, what in AUTO_DISMISS:
        if rx.search(bottom):
            run([tmux, 'send-keys', '-t', pane, key], capture_output=True)
            return what
    return None
AGY_GEMINI = 'gemini-4-neon'           # 11-27 Ricardo: agy runs Neon (Gemini only), never agy's Claude
# 11-27 (general 1127f): driver panes spent 703M of the 1.18B Gemini input tokens since 11-25, all at high effort, and
# the weekly pool lasted ~18 h. A respawned driver runs at no more than RH_AGY_DRIVER_EFFORT, and at most
# RH_AGY_MAX_DRIVERS agy drivers run on this host; a lane with a live deadline is never held back by the cap.
EFFORTS = ('low', 'medium', 'high', 'xhigh', 'max')


def driver_effort(model, effort):
    """(model, effort) capped at RH_AGY_DRIVER_EFFORT (default medium); a tier suffix on the model is capped too."""
    cap = os.environ.get('RH_AGY_DRIVER_EFFORT', 'medium')
    cap = cap if cap in EFFORTS else 'medium'
    for tier in EFFORTS:
        if model.endswith('-' + tier):
            model = model.removesuffix('-' + tier)
            effort = effort if effort in EFFORTS else tier
    effort = effort if effort in EFFORTS else cap
    return model, (effort if EFFORTS.index(effort) <= EFFORTS.index(cap) else cap)


def agy_drivers(tmux, run=subprocess.run):
    """Sessions on this host whose pane is an agy driving Gemini (agy-<lane>)."""
    out = run([tmux, 'list-panes', '-a', '-F', '#{session_name}\t#{pane_current_command}\t#{pane_start_command}'],
              capture_output=True, text=True).stdout
    return {row.split('\t')[0] for row in out.splitlines() if row.startswith('agy-') and '\tagy' in row
            and '--model claude' not in row}


def driver_slot(a, lane, now, held=None):
    """True when the lane may start an agy driver: under RH_AGY_MAX_DRIVERS (default 3) or holding a live deadline."""
    try:
        cap = int(os.environ.get('RH_AGY_MAX_DRIVERS', '3'))
    except ValueError:
        cap = 3
    held = agy_drivers(a.tmux) if held is None else held
    if len(held - {f'agy-{lane}'}) < cap:
        return True
    try:
        return bool(lane_registry.live_deadline(lane, datetime.fromtimestamp(now, timezone.utc), a.lanes))
    except Exception:                               # RULE #1: an unreadable registry never blocks the respawn
        return True
